# Server
PORT=5000
NODE_ENV=production

# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leela_tour_service?retryWrites=true&w=majority

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Public frontend URL used for password reset links and CORS.
# Multiple origins can be comma separated: https://leelatours.com,https://www.leelatours.com
CLIENT_URL=https://leelatours.com

# Email / SMTP (required in production for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_NAME="Leela Tours Admin"

# Seeding (only needed for the initial database setup)
# Production seeding deletes existing data, so it also requires SEED_FORCE=yes.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_FORCE=no
